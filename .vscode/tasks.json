{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMSIS Erase",
            "type": "shell",
            "command": [
                "echo Connect > .cmd.jlink &&",
                "echo Erase >> .cmd.jlink &&",
                "echo Exit >> .cmd.jlink &&",
                "JLinkExe -device MM32SPIN27PF -if swd -speed 1000 -commandfile .cmd.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}/HoverBoardMindMotion",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMSIS Load",
            "type": "shell",
            "command": [
                "echo Connect > .cmd.jlink &&",
                "echo LoadFile \"out/Hoverboard/SPIN27/Debug/HoverboardMM32SPIN27.hex\" >> .cmd.jlink &&",
                "echo Exit >> .cmd.jlink &&",
                "JLinkExe -device MM32SPIN27PF -if swd -speed 1000 -commandfile .cmd.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}/HoverBoardMindMotion",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMSIS Run",
            "type": "shell",
            "command": "JLinkGDBServerCLExe",
            "options": {
                "cwd": "${workspaceFolder}/HoverBoardMindMotion",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "args": [
                "-device",
                "MM32SPIN27PF",
                "-endian",
                "little",
                "-if",
                "swd",
                "-speed",
                "1000",
                "-nohalt",
                "-noir",
                "-nogui",
                "-localhostonly",
                "-silent",
                "-port",
                "3333",
                "-TelnetPort",
                "4444"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMSIS Load+Run",
            "dependsOn": [
                "CMSIS Load",
                "CMSIS Run"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
